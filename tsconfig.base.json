{
  // Settings shared by the main-process build (tsconfig.json) and the
  // renderer build (renderer/tsconfig.json).
  "compilerOptions": {
    "target": "ES2023",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "newLine": "lf"
  }
}
