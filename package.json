{
  "name": "unified-inbox",
  "productName": "Unified Inbox",
  "version": "2.0.0",
  "description": "All your email accounts in one Gmail-style inbox",
  "main": "out/main.js",
  "scripts": {
    "build": "node scripts/compile.js",
    "typecheck": "node scripts/compile.js --check",
    "start": "node scripts/compile.js && electron .",
    "dist": "electron-builder --win",
    "show-version": "node scripts/bump-version.js --show",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "build:release": "node scripts/bump-version.js patch && electron-builder --win --config.directories.output=release --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "imapflow": "^2.5.9",
    "mailparser": "^3.10.0",
    "material-symbols": "^0.48.0",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.unifiedinbox.app",
    "productName": "Unified Inbox",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*.js",
      "renderer/**/*",
      "!renderer/**/*.ts",
      "!renderer/tsconfig.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "beforeBuild": "scripts/compile.js"
  }
}
